# ============================================================================
# LETHAL GRID — MONETIZATION & ANALYTICS CONFIGURATION
# Copy this file to `.env` and replace with your real IDs when ready!
# ============================================================================

# 1. Google Analytics 4 (GA4) Measurement ID (Get free at https://analytics.google.com)
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# 2. Google AdSense Publisher ID (Get free at https://adsense.google.com)
VITE_ADSENSE_CLIENT_ID=ca-pub-0000000000000000

# 3. Ad Unit Slot IDs from your AdSense Dashboard
VITE_ADSENSE_TOP_SLOT=1111111111
VITE_ADSENSE_SIDEBAR_SLOT=2222222222
VITE_ADSENSE_REWARD_SLOT=3333333333

# 4. Production address, used for canonical links, social cards and the sitemap
# VITE_SITE_URL=https://lethal-grid.amit26543789.workers.dev

# 5. GameDistribution game ID, needed only for `npm run zip:gamedistribution`
# VITE_GD_GAME_ID=
